APP_NAME="Control de Asistencia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite alcanza de sobra: una carga son ~110.000 filas.
# Para MySQL o PostgreSQL, cambiar DB_CONNECTION y completar los datos de conexion.
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=database

# Usuario inicial que crea el seeder
ADMIN_NAME="Administrador del tablero"
ADMIN_EMAIL=sistemas@plasticoscarmen.com
ADMIN_PASSWORD=cambiar-esta-clave
